+
+    void UpdateStatusBar(bool update_all = false) override {
+        SpiLcdDisplay::UpdateStatusBar(update_all);
+        if (!IsSetupUICalled() || battery_percent_label_ == nullptr) {
+            return;
+        }
+
+        int battery_level;
+        bool charging;
+        bool discharging;
+        if (!Board::GetInstance().GetBatteryLevel(battery_level, charging, discharging)) {
+            return;
+        }
+
+        if (battery_level < 0) {
+            battery_level = 0;
+        } else if (battery_level > 100) {
+            battery_level = 100;
+        }
+
+        if (battery_level == last_battery_level_ && charging == last_battery_charging_ &&
+            discharging == last_battery_discharging_) {
+            return;
+        }
+        last_battery_level_ = battery_level;
+        last_battery_charging_ = charging;
+        last_battery_discharging_ = discharging;
+
+        char text[8];
+        std::snprintf(text, sizeof(text), "%d%%", battery_level);
+        lv_color_t color = lv_color_hex(0xAAB6C4);
+        if (charging) {
+            color = lv_color_hex(0x45D483);
+        } else if (discharging && battery_level <= 20) {
+            color = lv_color_hex(0xFF6B6B);
+        }
+
+        DisplayLockGuard lock(this);
+        lv_label_set_text(battery_percent_label_, text);
+        lv_obj_set_style_text_color(battery_percent_label_, color, 0);
+        if (!battery_percent_visible_) {
+            battery_percent_visible_ = true;
+            lv_obj_remove_flag(battery_percent_label_, LV_OBJ_FLAG_HIDDEN);
+            lv_obj_fade_in(battery_percent_label_, 500, 150);
+        }
+    }
+
+    void ShowVolumeFeedback(int volume, bool increasing) {
+        if (!IsSetupUICalled() || volume_popup_ == nullptr || volume_label_ == nullptr) {
+            return;
+        }
+
+        char text[32];
+        if (volume == 0) {
+            std::snprintf(text, sizeof(text), "Silencio 0%%");
+        } else {
+            std::snprintf(text, sizeof(text), "Volumen %c %d%%", increasing ? '+' : '-', volume);
+        }
+
+        DisplayLockGuard lock(this);
+        lv_label_set_text(volume_label_, text);
+        lv_obj_remove_flag(volume_popup_, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_move_foreground(volume_popup_);
+
+        esp_timer_stop(volume_popup_timer_);
+        ESP_ERROR_CHECK(esp_timer_start_once(volume_popup_timer_, kVolumePopupDurationMs * 1000));
+    }
+
+    void UpdateAudioDebug(int level_percent, int dbfs, bool voice_detected,
+                          bool wake_word_enabled, bool listening) override {
+        if (!audio_debug_enabled_ || !IsSetupUICalled() || audio_debug_panel_ == nullptr) {
+            return;
+        }
+
+        char level_text[32];
+        std::snprintf(level_text, sizeof(level_text), "MIC %d%%  %d dB", level_percent, dbfs);
+
+        const char* detector_state =
+            wake_word_enabled ? "DECÍ GIDDY" : (listening ? "HABLÁ AHORA" : "MIC PAUSADO");
+        char state_text[48];
+        std::snprintf(state_text, sizeof(state_text), "%s | %s",
+                      voice_detected ? "VOZ" : "silencio", detector_state);
+
+        DisplayLockGuard lock(this);
+        lv_label_set_text(audio_debug_level_label_, level_text);
+        lv_label_set_text(audio_debug_state_label_, state_text);
+        lv_bar_set_value(audio_debug_bar_, level_percent, LV_ANIM_OFF);
+        lv_obj_set_style_bg_color(audio_debug_bar_,
+                                  voice_detected ? lv_color_hex(0x45D483)
+                                                 : lv_color_hex(0x35A7FF),
+                                  LV_PART_INDICATOR);
+    }
+
+    void SetWakeWordDebug(const char* wake_word, float score) override {
+        if (!IsSetupUICalled() || audio_debug_wake_label_ == nullptr) {
+            return;
+        }
+
+        char text[64];
+        std::snprintf(text, sizeof(text), "Detectado: %s %.1f%%", wake_word, score * 100.0f);
+        DisplayLockGuard lock(this);
+        lv_label_set_text(audio_debug_wake_label_, text);
+    }
 
+    bool ToggleAudioDebug() override {
+        audio_debug_enabled_ = !audio_debug_enabled_;
+        if (!IsSetupUICalled() || audio_debug_panel_ == nullptr) {
+            return audio_debug_enabled_;
+        }
+
+        DisplayLockGuard lock(this);
+        if (audio_debug_enabled_) {
+            lv_obj_remove_flag(audio_debug_panel_, LV_OBJ_FLAG_HIDDEN);
+            lv_obj_move_foreground(audio_debug_panel_);
+        } else {
+            lv_obj_add_flag(audio_debug_panel_, LV_OBJ_FLAG_HIDDEN);
+        }
+        return audio_debug_enabled_;
+    }
+};
 
