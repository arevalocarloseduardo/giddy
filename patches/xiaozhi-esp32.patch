+void AudioService::UpdateInputLevel(const std::vector<int16_t>& data) {
+    if (data.empty() || codec_ == nullptr) {
+        return;
+    }
+
+    const size_t channels = std::max(1, codec_->input_channels());
+    uint64_t square_sum = 0;
+    size_t sample_count = 0;
+    for (size_t i = 0; i < data.size(); i += channels) {
+        const int64_t sample = data[i];
+        square_sum += static_cast<uint64_t>(sample * sample);
+        sample_count++;
+    }
+    if (sample_count == 0) {
+        return;
+    }
+
+    const float rms = std::sqrt(static_cast<float>(square_sum) / sample_count);
+    int dbfs = rms >= 1.0f
+                   ? static_cast<int>(std::lround(20.0f * std::log10(rms / 32768.0f)))
+                   : -90;
+    dbfs = std::clamp(dbfs, -90, 0);
+    const int level_percent = std::clamp((dbfs + 60) * 100 / 60, 0, 100);
+    input_level_dbfs_.store(dbfs);
+    input_level_percent_.store(level_percent);
+
+    const int64_t now = esp_timer_get_time();
+    if (now - last_input_level_notify_us_ >= 100000) {
+        last_input_level_notify_us_ = now;
+        if (callbacks_.on_input_level) {
+            callbacks_.on_input_level();
+        }
+    }
+}
